# Existing .env.local is deliberately not modified by this project.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_SERVER_ONLY_CLIENT_SECRET
# 32 random bytes, encoded as 64 hex characters or base64. Keep stable after connecting.
TOKEN_ENCRYPTION_KEY=
# Google Gemini: optional server-only key; Calendar OAuth credentials are separate.
GEMINI_API_KEY=
# Optional override; this is the application default.
GEMINI_MODEL=gemini-3.8-flash
